{"openapi":"3.1.0","info":{"title":"Portrait Engine Research API","version":"1.1.0","description":"Local-first S2/S3/S4 numerical CSS studies. Browser writes require session+CSRF; configured operator Bearer token is an alternative. Human judgments remain self-reported; no automatic ART_PASS."},"servers":[{"url":"/"}],"security":[{"sessionCookie":[]},{"operatorToken":[]}],"components":{"securitySchemes":{"sessionCookie":{"type":"apiKey","in":"cookie","name":"portrait"},"operatorToken":{"type":"http","scheme":"bearer"}},"parameters":{"Id":{"name":"id","in":"path","required":true,"schema":{"type":"string","pattern":"^[a-z0-9-]{1,80}$"}},"Csrf":{"name":"X-CSRF-Token","in":"header","description":"Required for cookie-authenticated writes; not with configured operator Bearer token.","schema":{"type":"string"}}},"responses":{"Ok":{"description":"Successful operation"},"Bad":{"description":"Invalid input, stale sample, unsupported stage/view/field"},"Forbidden":{"description":"Session, origin, token or CSRF rejected"}},"schemas":{"Session":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":40},"token":{"type":"string"}}},"RenderPayload":{"type":"object","additionalProperties":false,"properties":{"stage":{"type":"string","enum":["S2","S3","S4"],"default":"S2"},"identity":{"type":"string","description":"One registered identity; weights overrides this preset when supplied."},"weights":{"type":"array","minItems":6,"maxItems":6,"items":{"type":"number","minimum":-1.5,"maximum":1.5}},"light":{"enum":["left","front","right"],"default":"left"}},"anyOf":[{"required":["identity"]},{"required":["weights"]}]},"Job":{"type":"object","additionalProperties":false,"required":["operation"],"properties":{"operation":{"enum":["prepare","render","verify"]},"payload":{"type":"object","description":"prepare {}; render uses RenderPayload (stage defaults S2); verify {renderId}. Only registered operations: no arbitrary paths, URLs or shell commands."